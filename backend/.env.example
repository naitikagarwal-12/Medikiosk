# MediKiosk Backend — environment configuration
# Copy to .env and fill in real values. Never commit the .env file.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medikiosk

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS (frontend origin; comma-separated list is not supported here) ---
CORS_ORIGIN=http://localhost:8443

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- ABHA / NHA government health API ---
ABHA_API_URL=https://api.abha.gov.in/v1
ABHA_API_KEY=your-abha-api-key-here
ABHA_API_SECRET=your-abha-api-secret-here

# --- Groq multimodal AI (tongue / eye / voice analysis) ---
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-api-key-here

# --- OCR ---
OCR_PROVIDER=tesseract

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- Email (notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=MediKiosk <your-email@example.com>
