# MediKiosk Bhashini Bridge — environment variables
# Copy to .env and fill in real values.

# Port the service listens on (the React frontend reads VITE_BHASHINI_URL).
BHASHINI_PORT=5001

# Bhasini ULCA authentication (Step A — getModelsPipeline)
# These two headers are sent to https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# BHASHINI_API_KEY  -> sent as "userID" header
# BHASHINI_UDYAT_KEY -> sent as "ulcaApiKey" header
BHASHINI_API_KEY=your_bhashini_ulca_userid_here
BHASHINI_UDYAT_KEY=your_bhashini_ulca_api_key_here

# Bhasini inference authentication (Step B — compute)
# Sent as Authorization: Bearer <BHASHINI_INFERENCE_KEY>
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here

# (Optional) Override the inference base URL.
# Default: https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# BHASHINI_INFERENCE_URL=

# (Optional) How long to cache getModelsPipeline results, in seconds.
# Default: 3600
# BHASHINI_PIPELINE_CACHE_TTL=3600

# Set FLASK_DEBUG=1 to enable Flask auto-reload + verbose error pages.
# In production, leave this off.
FLASK_DEBUG=0

# Groq fallback key (used when Bhasini v1 pipeline is not configured)
GROQ_API_KEY=your_groq_api_key_here
