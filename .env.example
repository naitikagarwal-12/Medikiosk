# Groq API key (free tier: https://console.groq.com)
# Used for text → sign-unit tokenization in the sign language avatar.
VITE_GROQ_API_KEY=your_groq_api_key_here

# Backend API base URL (the Render web service).
# Leave unset in local development to default to http://localhost:3001.
VITE_API_URL=http://localhost:3001

# Bhashini Bridge service URL (Python Flask, runs on port 5001)
# Used for Indic-language translation + TTS + ASR.
VITE_BHASHINI_URL=http://localhost:5001
